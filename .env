# Project configuration
PROJECT_NAME=data-quality-platform

# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=postgres

# Airflow specific PostgreSQL DB configuration
AIRFLOW_DB=airflow
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow_secure_pass

# Great Expectations & Warehouse PostgreSQL configuration
GE_DB=ge_store
GE_USER=ge_user
GE_PASSWORD=ge_secure_pass

WAREHOUSE_DB=warehouse_db
WAREHOUSE_USER=warehouse_user
WAREHOUSE_PASSWORD=warehouse_secure_pass

# Airflow configurations
AIRFLOW_IMAGE_NAME=airflow-custom:latest
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Spark configurations
SPARK_IMAGE_NAME=spark-custom:latest
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
